      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Normalize keys by stripping invisible characters and whitespace\nconst rawItem = $input.item.json;\nconst item = {};\nfor (const key in rawItem) {\n  const cleanKey = key.replace(/[\\u200B-\\u200D\\uFEFF\\u00A0]/g, '').trim();\n  item[cleanKey] = rawItem[key];\n}\n\nconst errors = [];\nconst emailRegex = /^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/;\n\nif (!item.Name || item.Name.trim() === '') errors.push('Name is missing');\nif (!item.Email || !emailRegex.test(item.Email)) errors.push('Employee email is missing or invalid');\nif (!item.Department || item.Department.trim() === '') errors.push('Department is missing');\nif (!item['Start Date'] || item['Start Date'].trim() === '') errors.push('Start date is missing');\n\nreturn {\n  json: {\n    employeeName: item.Name,\n    employeeEmail: item.Email,\n    department: item.Department,\n    startDate: item['Start Date'],\n    rowNumber: item.row_number,\n    isValid: errors.length === 0,\n    validationErrors: errors.join('; ')\n  }\n};"
      },
